{
  "name": "VolleyCalc",
  "short_name": "VolleyCalc",
  "description": "Разметка и статистика волейбольных матчей: тренер и игрок",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f4f6",
  "theme_color": "#1d5cc4",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/json",
            ".json",
            "application/zip",
            ".zip",
            "application/octet-stream",
            "text/plain",
            "video/mp4",
            ".mp4",
            "video/webm",
            ".webm",
            "video/quicktime",
            ".mov"
          ]
        }
      ]
    }
  }
}
